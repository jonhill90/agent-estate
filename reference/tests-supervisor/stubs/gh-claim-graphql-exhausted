#!/bin/bash
# Wraps stubs/gh-claim to simulate a GitHub account whose GraphQL budget is
# exhausted (agent-supervisor#144): `gh issue ...` / `gh pr ...` (GraphQL)
# fail exactly the way a real 0/5000 budget does, while `gh api ...` (REST
# core) is passed through to the real stub untouched.
#
# Used by test_claim_graphql_exhausted.sh to prove claim.sh's REST
# conversion actually avoids the deadlock the issue names: a dispatcher must
# still be able to check/take/release/list/find-stale claims with GraphQL at
# 0/5000.
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
case "$1" in
  issue|pr)
    echo 'gh: GraphQL: API rate limit exceeded (graphqlRateLimit)' >&2
    exit 1 ;;
  *)
    exec "$HERE/gh-claim" "$@" ;;
esac
