#!/bin/bash
# Stub `curl` for tests/supervisor/test_laneview.sh (agent-dotfiles#231).
#
# Why a stub and not a real daemon: the defect under test is shell control
# flow inside opensessions.sh -- a failed POST used to abort only a
# subshell. A stub answers the question the defect actually poses (what
# does the script do when one post fails and the next succeeds?) without
# needing a listening socket, which the sandbox that reviewed #231 could
# not provide. It is not evidence that OpenSessions itself behaves this
# way; that half is #173's live measurement.
#
# Behaviour, driven by the environment:
#   CURL_STUB_LOG   file to append one line per request: <method> <url>
#   CURL_STUB_FAIL  request number (1-based, counting only /api/agent-event)
#                   to answer with HTTP 500 instead of 204
#   CURL_STUB_COUNT file used to keep that count across invocations
# Exits 0 in both cases: an HTTP 500 is a successful curl, which is exactly
# the distinction opensessions.sh has to get right.
url=""
body=""
prev=""
for arg in "$@"; do
  case "$arg" in
    http://*|https://*) url="$arg" ;;
  esac
  [ "$prev" = "-d" ] && body="$arg"
  prev="$arg"
done
log() { [ -n "${CURL_STUB_LOG:-}" ] && printf '%s\nBODY %s\n' "$1" "$body" >> "$CURL_STUB_LOG"; return 0; }

case "$url" in
  */api/agent-event)
    n=1
    if [ -n "${CURL_STUB_COUNT:-}" ]; then
      [ -f "$CURL_STUB_COUNT" ] && n=$(( $(cat "$CURL_STUB_COUNT") + 1 ))
      echo "$n" > "$CURL_STUB_COUNT"
    fi
    log "POST $url #$n"
    if [ "${CURL_STUB_FAIL:-0}" = "$n" ]; then
      echo 500
    else
      echo 204
    fi
    ;;
  *)
    log "POST $url"
    echo 204
    ;;
esac
exit 0
