# Copy to `.env` (gitignored) and fill in your own values, or export these
# directly in your shell / LaunchAgent environment. Nothing here is read
# from a `.env` file automatically -- source it yourself before running,
# e.g. `set -a && source .env && set +a`. Every variable below already has
# a safe built-in default (the one this estate runs with), so an unset
# `.env` -- including on a fresh clone -- changes nothing and the test
# suite passes without one.

# Where the ledger, dispatch state, and watchdog stamps live.
# Default: ~/.local/state/agent-dotfiles-supervisor
AGENT_SUPERVISOR_STATE_DIR=

# The repos this supervisor drives GitHub sensors and dispatch against.
# Colon-separated `name=path=owner/repo` entries. Leave unset to use the
# built-in list (see cli.py:DEFAULT_REPOSITORIES).
# Example: SUPERVISOR_REPOSITORIES="dots=$HOME/src/agent-dotfiles=you/agent-dotfiles"
SUPERVISOR_REPOSITORIES=

# tmux binary to invoke. Default: tmux (resolved via PATH).
AGENT_TMUX_BIN=

# GitHub login `digest.sh` reports and queries PRs/issues for.
# Default: jonhill90
DIGEST_OWNER=
