#!/bin/bash
# Stub `gh` for test_branch_sweep.sh's GitHub-cross-check case.
#
# branch-sweep.sh's own GitHub path is two calls: `gh repo view <slug>` (a
# reachability probe) and `gh pr list --repo <slug> --state all --limit
# <n> --json headRefName,state -q '...'` (the actual PR record). Answered
# from STUB_GH_PR_ROWS, a newline-separated list of "<headRefName>\t<STATE>"
# rows -- the same shape `gh pr list ... -q '.[] | [.headRefName,.state] |
# @tsv'` really produces, so branch-sweep.sh's own parsing is exercised
# unmodified, not special-cased for the stub.
if [ "$1" = "repo" ] && [ "$2" = "view" ]; then
  exit 0
fi
if [ "$1" = "pr" ] && [ "$2" = "list" ]; then
  printf '%s\n' "${STUB_GH_PR_ROWS:-}"
  exit 0
fi
echo "stub gh: unhandled invocation: $*" >&2
exit 1
