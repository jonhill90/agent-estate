#!/bin/bash
# Stub `gh` for test_worktree_pr_sync.sh (agent-estate#886). Unlike
# tests/supervisor/stubs-branch-sweep/gh (which answers every `pr list`
# call with one fixed row set, since branch-sweep.sh's own tests only ever
# ask one shape of question), this test drives TWO real `gh pr list` calls
# per worktree.sh run -- `_gc_fetch_merged_prs`'s `--json headRefName,state`
# and `_gc_fetch_pr_numbers`'s `--json headRefName,number` -- and they must
# answer with genuinely different columns, the same way real `gh` would.
# Distinguished by inspecting which `--json` fields were actually
# requested, not by call order.
if [ "$1" = "repo" ] && [ "$2" = "view" ]; then
  exit 0
fi
if [ "$1" = "pr" ] && [ "$2" = "list" ]; then
  for arg in "$@"; do
    case "$arg" in
      *headRefName,number*) printf '%s\n' "${STUB_GH_PR_NUM_ROWS:-}"; exit 0 ;;
      *headRefName,state*)  printf '%s\n' "${STUB_GH_PR_STATE_ROWS:-}"; exit 0 ;;
    esac
  done
  echo "stub gh: pr list called with unrecognized --json fields: $*" >&2
  exit 1
fi
echo "stub gh: unhandled invocation: $*" >&2
exit 1
