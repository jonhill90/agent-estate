#!/usr/bin/env python3
"""Stub `claude -p --output-format json` for dispatch.sh/dispatch-claude-print.sh
shell tests (agent-supervisor#171).

Speaks just enough of `claude_print_transport.py`'s contract: a
`--session-id <uuid> <prompt>` call (the register handshake) answers with
that same id; a `--resume <uuid> <prompt>` call (the real delivery) answers
with a completed result. Every invocation is single-shot subprocess, same as
the real CLI -- no persistent process, no reader thread.

CLAUDE_PRINT_BROKEN=1  -- exit 1 immediately, before printing anything.
                          Simulates a `claude` that cannot be reached at all
                          -- the mutation test for #171's fail-closed
                          requirement (never falls back to send-keys).
CLAUDE_PRINT_LOG=<path> -- the prompt text of every `--resume` call is
                          appended here, one per line, so a test can assert
                          the real brief pointer crossed argv, never
                          send-keys.
"""
import json
import os
import sys
import uuid

if os.environ.get("CLAUDE_PRINT_BROKEN"):
    sys.exit(1)

args = sys.argv[1:]


def value_after(flag):
    return args[args.index(flag) + 1] if flag in args else None


session_id = value_after("--session-id")
resume_id = value_after("--resume")
prompt = args[-1] if args else ""

if session_id:
    # The register handshake (ClaudePrintAdapter.register_lane).
    result = {
        "type": "result",
        "is_error": False,
        "session_id": session_id,
        "result": "ready",
        "subtype": "success",
    }
elif resume_id:
    log_path = os.environ.get("CLAUDE_PRINT_LOG")
    if log_path:
        with open(log_path, "a") as fh:
            fh.write(prompt + "\n")
    result = {
        "type": "result",
        "is_error": False,
        "session_id": resume_id,
        "result": "stub claude: brief received over claude-print, task complete",
        "subtype": "success",
    }
else:
    result = {
        "type": "result",
        "is_error": True,
        "session_id": str(uuid.uuid4()),
        "result": "stub claude: neither --session-id nor --resume given",
        "subtype": "error",
    }

sys.stdout.write(json.dumps(result) + "\n")
sys.stdout.flush()
