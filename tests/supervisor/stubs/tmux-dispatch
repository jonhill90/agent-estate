#!/bin/bash
# Stub tmux for dispatch.sh tests.
#
# It is tmux-lanes plus a recorder: every rename-window and send-keys is
# appended verbatim to TMUX_LOG, so a test can assert on what a lane WOULD
# have received -- including the case that matters most, which is that
# nothing was sent at all.
#
# LANES_FIXTURE holds one line per window, same format tmux-lanes uses:
#   <index>|<name>|<command>|<pane-text>|<activity-age-seconds>|<in-mode>
F="${LANES_FIXTURE:?}"
LOG="${TMUX_LOG:-/dev/null}"
sub="$1"; shift

PANES="${TMUX_PANES:-${TMPDIR:-/tmp}/tmux-dispatch-panes}"
mkdir -p "$PANES"

# agent-dotfiles#159. STUB_MENU_PANES names windows (space-separated) whose
# pane is a SELECTION MENU, not a text buffer -- the distinction the real bug
# turned on: a reply routed to a menu-blocked lane was consumed as navigation
# keys, not typed text, and the trailing Enter committed whatever option was
# already highlighted (changing a lane's `/theme` setting in the live
# incident). Everywhere else in this stub, "pane" means the append-only input
# line modelled below; a window named here is the one exception, and it is
# opt-in per test so every existing fixture keeps the old (accurate, for a
# real text box) behaviour untouched.
#
# STUB_MENU_AS_TEXT=1 turns this back off without removing the window from
# STUB_MENU_PANES -- agent-dotfiles#159's mutation-check 3: revert the stub to
# the old single model and confirm the test that depends on the distinction
# goes red. If it does not, the test was never exercising the distinction.
is_menu_pane() {
  [ "${STUB_MENU_AS_TEXT:-0}" != 1 ] || return 1
  local target="$1" p
  for p in ${STUB_MENU_PANES:-}; do [ "$p" = "$target" ] && return 0; done
  return 1
}

case "$sub" in
  rename-window|send-keys)
    printf '%s %s\n' "$sub" "$*" >> "$LOG"
    if [ "$sub" = send-keys ]; then
      # Model a pane's input line, so a test can assert on what the lane can
      # actually SEE -- not merely on what was sent at it. DISPATCH_DROP_PREFIX
      # reproduces the failure observed live on 2026-08-11: characters typed
      # while the harness repaints are silently swallowed, and the lane is left
      # holding a truncated brief.
      #
      # -l matters here (agent-dotfiles#152): real tmux only treats an
      # argument as a key name (Enter, C-u, C-c, Escape, ...) when `-l` is
      # ABSENT. With `-l`, every argument is typed as literal characters, key
      # name or not -- that is the whole of the fix for a message that IS a
      # key name. A stub that appended every non-Enter/C-u argument as text
      # regardless of `-l` could not tell a literal-safe send from an unsafe
      # one; this one can.
      win=""; keys=(); literal=0
      while [ $# -gt 0 ]; do
        case "$1" in
          # Strip both the session prefix and a trailing `.pane` the same
          # way the capture-pane/list-panes parsing below this case
          # statement already does (agent-dotfiles#193) -- a target like
          # `t:1.1` used to leave send-keys writing to buffer "1.1" while
          # capture-pane read fixture/buffer "1", so a caller addressing a
          # specific pane (not just a window) saw its own send-keys as
          # invisible. No prior caller of this stub addressed a pane
          # suffix, so nothing exercised the mismatch until now.
          -t) win="${2##*:}"; win="${win%%.*}"; shift 2 ;;
          -l) literal=1; shift ;;
          *) keys+=("$1"); shift ;;
        esac
      done
      buf="$PANES/$win"
      if is_menu_pane "$win"; then
        # #159. A menu does not have a text buffer to append to -- there is
        # no `buf` for it to land in, `-l` or not: real tmux's `-l` only
        # controls whether TMUX itself interprets an argument as a key name
        # before sending it; either way the bytes reach the app as keypresses,
        # and a selector app reads keypresses as navigation, not as a string
        # to insert. That is the whole of the bug: routing text with `-l` was
        # necessary (#152) and not sufficient (#159).
        #
        # Modelled minimally: a digit sets the pending selection (arrow-key
        # navigation would do the same in a real menu); anything else is
        # swallowed, exactly as an unrecognised keypress would be; Enter
        # commits whichever option is CURRENTLY pending -- defaulting to
        # STUB_MENU_DEFAULT (the option the fixture says is highlighted) if
        # nothing sent so far happened to be a digit. Nothing here EVER
        # touches `.submitted` -- that is the file a text delivery test reads,
        # and the point of this model is that a menu never writes it.
        for k in "${keys[@]:-}"; do
          if [ "$literal" = 1 ]; then
            # A literal send (agent-dotfiles#152's `-l`, which inbox-route.sh
            # always uses) still delivers the string to the app one keypress
            # at a time -- `-l` changes how TMUX parses its OWN argument, not
            # how many keys the app on the other end receives. "yes" sent -l
            # is `y`, `e`, `s`: none select an option, none is Enter, so a
            # menu just swallows all three.
            n=${#k}; ci=0
            while [ "$ci" -lt "$n" ]; do
              c="${k:$ci:1}"
              case "$c" in [0-9]) printf '%s' "$c" > "$buf.menu-pending" ;; esac
              ci=$((ci+1))
            done
            continue
          fi
          case "$k" in
            [0-9]) printf '%s' "$k" > "$buf.menu-pending" ;;
            Enter)
              sel="${STUB_MENU_DEFAULT:-1}"
              [ -s "$buf.menu-pending" ] && sel="$(cat "$buf.menu-pending")"
              printf '%s\n' "$sel" >> "$buf.selected"
              printf '%s\n' "Enter" >> "$buf.keys"
              rm -f "$buf.menu-pending" ;;
            *) : ;;
          esac
        done
        exit 0
      fi
      for k in "${keys[@]:-}"; do
        if [ "$literal" = 1 ]; then
          printf '%s' "$k" >> "$buf"
          continue
        fi
        case "$k" in
          # Enter SUBMITS: it empties the input box. This stub used to treat it
          # as a no-op, which is the same misunderstanding #141 is about -- the
          # dispatcher sent Enter, reported success, and never checked that the
          # box had emptied. A stub whose Enter does nothing cannot tell a
          # submitted brief from one still sitting in the box, so it agreed
          # with the code about the one thing the code had wrong.
          #
          # DISPATCH_SWALLOW_ENTER=1 reproduces the live failure: `/clear` takes
          # longer to repaint than the dispatcher waits, and the Enter that
          # follows is eaten by the reset. The text stays in the box, nothing
          # runs, and every instrument reports the lane idle.
          #
          # It is ALSO logged to <pane>.keys (#152). Emptying the box is not
          # evidence Enter was sent -- an empty box is equally what "nothing was
          # ever typed" looks like -- and deleting the Enter call used to pass
          # every assertion in the routing suite.
          #
          # And the submitted text is recorded before the box is cleared, one
          # line per submit. A real pane keeps what it submitted: the text
          # scrolls up into the transcript. Without that record, emptying the
          # box destroys the only evidence a delivery test has -- what the lane
          # actually received -- and "submitted" becomes indistinguishable from
          # "never typed". #142's routing suite needs exactly this distinction:
          # `delivered` has to mean the reply arrived and went in.
          Enter)
            printf '%s\n' "Enter" >> "$buf.keys"
            if [ "${DISPATCH_SWALLOW_ENTER:-0}" != 1 ]; then
              if [ -s "$buf" ]; then cat "$buf" >> "$buf.submitted"; printf '\n' >> "$buf.submitted"; fi
              : > "$buf"
            fi ;;
          C-u)   : > "$buf"; printf '%s\n' "C-u" >> "$buf.keys" ;;
          C-c|Escape|Up|Down|Left|Right|Tab)
            # A real key name with no -l fires the action, not the text --
            # it never reaches the pane buffer at all.
            printf '%s\n' "$k" >> "$buf.keys" ;;
          *)
            drop="${DISPATCH_DROP_PREFIX:-0}"
            # Only the brief itself, not a short command like `/clear`: the
            # live failure was the long message typed into a repainting pane.
            if [ "$drop" != 0 ] && [ ! -e "$buf.dropped" ] && [ "${#k}" -gt "$drop" ]; then
              : > "$buf.dropped"
              k="${k:$drop}"
            fi
            printf '%s' "$k" >> "$buf" ;;
        esac
      done
    fi
    exit 0 ;;
esac

target=""; fmt=""
args=("$@")
while [ $# -gt 0 ]; do
  case "$1" in
    -t) target="$2"; shift 2 ;;
    -p|-S) shift ;;
    -*) shift ;;
    *) fmt="$1"; shift ;;
  esac
done
win="${target##*:}"; win="${win%%.*}"
line=$(awk -F'|' -v w="$win" '$1==w' "$F")
case "$sub" in
  has-session) exit 0 ;;
  list-windows) cut -d'|' -f1 "$F" ;;
  list-panes)
    now=$(date +%s)
    while IFS='|' read -r i n c t a m; do
      printf '%s\t%s\t%s\t%s\t%s\n' "$i" "$n" "$c" "$((now-a))" "${m:-0}"
    done < "$F" ;;
  display-message)
    case "$fmt" in
      '#{window_activity}') echo $(( $(date +%s) - $(cut -d'|' -f5 <<<"$line") )) ;;
      '#{pane_id}|#{pane_current_command}|#{pane_current_path}|#{socket_path}|#{session_created}|#{session_id}')
        # STUB_LANE_META_BROKEN models a real tmux failure on the ledger's
        # own identity probe (agent-dotfiles#144 finding 4): a target that
        # cannot be resolved prints a single-line error with NO pipe in it,
        # not an empty string and not a partially-filled template. dispatch.sh
        # has one guard specifically for this (`LANE_META` sanity check); a
        # test that never exercises this branch cannot tell whether that
        # guard does anything.
        if [ -n "${STUB_LANE_META_BROKEN:-}" ]; then
          echo "can't find pane: $target"
        else
          value="$fmt"
          value="${value//'#{window_name}'/$(cut -d'|' -f2 <<<"$line")}"
          value="${value//'#{pane_current_command}'/$(cut -d'|' -f3 <<<"$line")}"
          value="${value//'#{pane_id}'/%$win}"
          value="${value//'#{pane_current_path}'/${STUB_PANE_PATH:-$PWD}}"
          value="${value//'#{socket_path}'/${STUB_SOCKET_PATH:-/tmp/stub-tmux-socket}}"
          value="${value//'#{session_created}'/${STUB_SESSION_CREATED:-1700000000}}"
          value="${value//'#{session_id}'/${STUB_SESSION_ID:-\$0}}"
          printf '%s\n' "$value"
        fi ;;
      *)
        # Token expansion rather than whole-format matching, so a caller
        # asking for several fields in one call gets them the way real tmux
        # does. dispatch.sh reads the pane's identity this way for the ledger
        # record (#140); the single-token formats used elsewhere still come
        # out unchanged.
        #
        # The pane identity fields have no fixture column -- the fixture is
        # about lane STATE -- so they are synthesised per window, and
        # overridable where a test needs to assert on the value.
        value="$fmt"
        value="${value//'#{window_name}'/$(cut -d'|' -f2 <<<"$line")}"
        value="${value//'#{pane_current_command}'/$(cut -d'|' -f3 <<<"$line")}"
        value="${value//'#{pane_id}'/%$win}"
        value="${value//'#{pane_current_path}'/${STUB_PANE_PATH:-$PWD}}"
        value="${value//'#{socket_path}'/${STUB_SOCKET_PATH:-/tmp/stub-tmux-socket}}"
        value="${value//'#{session_created}'/${STUB_SESSION_CREATED:-1700000000}}"
        value="${value//'#{session_id}'/${STUB_SESSION_ID:-\$0}}"
        printf '%s\n' "$value" ;;
    esac ;;
  capture-pane)
    # The input box, in the shape a real Claude Code pane paints it: `❯` plus
    # U+00A0, bounded by a pair of horizontal rules. input-box.sh keys on that
    # shape rather than on plain text, so a stub that emitted the raw buffer
    # would be testing a pane no harness produces. It is emitted ABOVE the
    # fixture's status line because that is where it sits on screen, and
    # because lanes.sh reads the last non-empty line.
    rule=$(printf '─%.0s' $(seq 1 40))
    printf '%s\n' "$rule"
    if [ -s "$PANES/$win" ]; then
      printf '\033[39m❯\xc2\xa0'
      # Whatever has been typed into this pane and not yet cleared. Line-wrapped
      # at DISPATCH_PANE_COLS columns, because a real pane wraps a long path
      # across lines and a caller checking for it must survive that.
      #
      # DISPATCH_PANE_ROWS models the OTHER half of a real input box, and this
      # stub was blind to it until #118: the box shows only its last few rows and
      # scrolls INTERNALLY, so a long enough message pushes its own head out of
      # what capture-pane can see. Measured against a real Claude Code TUI at
      # 80x24, the head goes out of view somewhere between 450 and 500 characters
      # -- and the stub, modelling an input line of unbounded height, reported
      # every length as fully visible. A message that broke dispatch to `free-9`
      # and `free-10` passed all 78 assertions.
      #
      # Unset (the default) keeps the old unbounded behaviour, so existing tests
      # are unchanged; set it to model a small lane.
      #
      # The buffer is written without a trailing newline, so one is added after
      # it. Without that, the closing rule lands on the same line as the last
      # row of the box, that line stops matching `^─+$`, and input-box.sh
      # answers `unknown` for a box it can plainly see.
      if [ -n "${DISPATCH_PANE_ROWS:-}" ]; then
        fold -w "${DISPATCH_PANE_COLS:-60}" "$PANES/$win" | tail -n "$DISPATCH_PANE_ROWS"
      else
        fold -w "${DISPATCH_PANE_COLS:-60}" "$PANES/$win"
      fi
      printf '\n'
    else
      printf '\033[39m❯\xc2\xa0\n'
    fi
    printf '%s\n' "$rule"
    printf '%b\n' "$(cut -d'|' -f4 <<<"$line")"
    ;;
esac
exit 0
