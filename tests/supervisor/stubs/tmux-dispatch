#!/bin/bash
# Stub tmux for dispatch.sh tests.
#
# It is tmux-lanes plus a recorder: every rename-window and send-keys is
# appended verbatim to TMUX_LOG, so a test can assert on what a lane WOULD
# have received -- including the case that matters most, which is that
# nothing was sent at all.
#
# LANES_FIXTURE holds one line per window, same format tmux-lanes uses:
#   <index>|<name>|<command>|<pane-text>|<activity-age-seconds>|<in-mode>
F="${LANES_FIXTURE:?}"
LOG="${TMUX_LOG:-/dev/null}"
sub="$1"; shift

PANES="${TMUX_PANES:-${TMPDIR:-/tmp}/tmux-dispatch-panes}"
mkdir -p "$PANES"

case "$sub" in
  rename-window|send-keys)
    printf '%s %s\n' "$sub" "$*" >> "$LOG"
    if [ "$sub" = send-keys ]; then
      # Model a pane's input line, so a test can assert on what the lane can
      # actually SEE -- not merely on what was sent at it. DISPATCH_DROP_PREFIX
      # reproduces the failure observed live on 2026-08-11: characters typed
      # while the harness repaints are silently swallowed, and the lane is left
      # holding a truncated brief.
      win=""; keys=()
      while [ $# -gt 0 ]; do
        case "$1" in
          -t) win="${2##*:}"; shift 2 ;;
          *) keys+=("$1"); shift ;;
        esac
      done
      buf="$PANES/$win"
      for k in "${keys[@]:-}"; do
        case "$k" in
          # Enter SUBMITS: it empties the input box. This stub used to treat it
          # as a no-op, which is the same misunderstanding #141 is about -- the
          # dispatcher sent Enter, reported success, and never checked that the
          # box had emptied. A stub whose Enter does nothing cannot tell a
          # submitted brief from one still sitting in the box, so it agreed
          # with the code about the one thing the code had wrong.
          #
          # DISPATCH_SWALLOW_ENTER=1 reproduces the live failure: `/clear` takes
          # longer to repaint than the dispatcher waits, and the Enter that
          # follows is eaten by the reset. The text stays in the box, nothing
          # runs, and every instrument reports the lane idle.
          Enter) [ "${DISPATCH_SWALLOW_ENTER:-0}" = 1 ] || : > "$buf" ;;
          C-u)   : > "$buf" ;;
          *)
            drop="${DISPATCH_DROP_PREFIX:-0}"
            # Only the brief itself, not a short command like `/clear`: the
            # live failure was the long message typed into a repainting pane.
            if [ "$drop" != 0 ] && [ ! -e "$buf.dropped" ] && [ "${#k}" -gt "$drop" ]; then
              : > "$buf.dropped"
              k="${k:$drop}"
            fi
            printf '%s' "$k" >> "$buf" ;;
        esac
      done
    fi
    exit 0 ;;
esac

target=""; fmt=""
args=("$@")
while [ $# -gt 0 ]; do
  case "$1" in
    -t) target="$2"; shift 2 ;;
    -p|-S) shift ;;
    -*) shift ;;
    *) fmt="$1"; shift ;;
  esac
done
win="${target##*:}"; win="${win%%.*}"
line=$(awk -F'|' -v w="$win" '$1==w' "$F")
case "$sub" in
  has-session) exit 0 ;;
  list-windows) cut -d'|' -f1 "$F" ;;
  list-panes)
    now=$(date +%s)
    while IFS='|' read -r i n c t a m; do
      printf '%s\t%s\t%s\t%s\t%s\n' "$i" "$n" "$c" "$((now-a))" "${m:-0}"
    done < "$F" ;;
  display-message)
    case "$fmt" in
      '#{window_activity}') echo $(( $(date +%s) - $(cut -d'|' -f5 <<<"$line") )) ;;
      '#{pane_id}|#{pane_current_command}|#{pane_current_path}|#{socket_path}|#{session_created}|#{session_id}')
        # STUB_LANE_META_BROKEN models a real tmux failure on the ledger's
        # own identity probe (agent-dotfiles#144 finding 4): a target that
        # cannot be resolved prints a single-line error with NO pipe in it,
        # not an empty string and not a partially-filled template. dispatch.sh
        # has one guard specifically for this (`LANE_META` sanity check); a
        # test that never exercises this branch cannot tell whether that
        # guard does anything.
        if [ -n "${STUB_LANE_META_BROKEN:-}" ]; then
          echo "can't find pane: $target"
        else
          value="$fmt"
          value="${value//'#{window_name}'/$(cut -d'|' -f2 <<<"$line")}"
          value="${value//'#{pane_current_command}'/$(cut -d'|' -f3 <<<"$line")}"
          value="${value//'#{pane_id}'/%$win}"
          value="${value//'#{pane_current_path}'/${STUB_PANE_PATH:-$PWD}}"
          value="${value//'#{socket_path}'/${STUB_SOCKET_PATH:-/tmp/stub-tmux-socket}}"
          value="${value//'#{session_created}'/${STUB_SESSION_CREATED:-1700000000}}"
          value="${value//'#{session_id}'/${STUB_SESSION_ID:-\$0}}"
          printf '%s\n' "$value"
        fi ;;
      *)
        # Token expansion rather than whole-format matching, so a caller
        # asking for several fields in one call gets them the way real tmux
        # does. dispatch.sh reads the pane's identity this way for the ledger
        # record (#140); the single-token formats used elsewhere still come
        # out unchanged.
        #
        # The pane identity fields have no fixture column -- the fixture is
        # about lane STATE -- so they are synthesised per window, and
        # overridable where a test needs to assert on the value.
        value="$fmt"
        value="${value//'#{window_name}'/$(cut -d'|' -f2 <<<"$line")}"
        value="${value//'#{pane_current_command}'/$(cut -d'|' -f3 <<<"$line")}"
        value="${value//'#{pane_id}'/%$win}"
        value="${value//'#{pane_current_path}'/${STUB_PANE_PATH:-$PWD}}"
        value="${value//'#{socket_path}'/${STUB_SOCKET_PATH:-/tmp/stub-tmux-socket}}"
        value="${value//'#{session_created}'/${STUB_SESSION_CREATED:-1700000000}}"
        value="${value//'#{session_id}'/${STUB_SESSION_ID:-\$0}}"
        printf '%s\n' "$value" ;;
    esac ;;
  capture-pane)
    # The input box, in the shape a real Claude Code pane paints it: `❯` plus
    # U+00A0, bounded by a pair of horizontal rules. input-box.sh keys on that
    # shape rather than on plain text, so a stub that emitted the raw buffer
    # would be testing a pane no harness produces. It is emitted ABOVE the
    # fixture's status line because that is where it sits on screen, and
    # because lanes.sh reads the last non-empty line.
    rule=$(printf '─%.0s' $(seq 1 40))
    printf '%s\n' "$rule"
    if [ -s "$PANES/$win" ]; then
      printf '\033[39m❯\xc2\xa0'
      # Whatever has been typed into this pane and not yet cleared. Line-wrapped
      # at DISPATCH_PANE_COLS columns, because a real pane wraps a long path
      # across lines and a caller checking for it must survive that.
      #
      # DISPATCH_PANE_ROWS models the OTHER half of a real input box, and this
      # stub was blind to it until #118: the box shows only its last few rows and
      # scrolls INTERNALLY, so a long enough message pushes its own head out of
      # what capture-pane can see. Measured against a real Claude Code TUI at
      # 80x24, the head goes out of view somewhere between 450 and 500 characters
      # -- and the stub, modelling an input line of unbounded height, reported
      # every length as fully visible. A message that broke dispatch to `free-9`
      # and `free-10` passed all 78 assertions.
      #
      # Unset (the default) keeps the old unbounded behaviour, so existing tests
      # are unchanged; set it to model a small lane.
      #
      # The buffer is written without a trailing newline, so one is added after
      # it. Without that, the closing rule lands on the same line as the last
      # row of the box, that line stops matching `^─+$`, and input-box.sh
      # answers `unknown` for a box it can plainly see.
      if [ -n "${DISPATCH_PANE_ROWS:-}" ]; then
        fold -w "${DISPATCH_PANE_COLS:-60}" "$PANES/$win" | tail -n "$DISPATCH_PANE_ROWS"
      else
        fold -w "${DISPATCH_PANE_COLS:-60}" "$PANES/$win"
      fi
      printf '\n'
    else
      printf '\033[39m❯\xc2\xa0\n'
    fi
    printf '%s\n' "$rule"
    printf '%b\n' "$(cut -d'|' -f4 <<<"$line")"
    ;;
esac
exit 0
