#!/usr/bin/env python3
"""Stub `pi --mode rpc` for dispatch-pi-rpc.sh's shell test.

Speaks just enough of the real protocol `pi_transport.py`'s module docstring
and `test_pi_transport.py`'s FakePeer describe: `get_state` answers a
sessionId synchronously; `prompt` acks acceptance only, then streams
`message_end` -> `agent_settled` asynchronously with no id to correlate.

PI_RPC_BROKEN=1     -- exit immediately after startup, before answering
                       anything. Simulates a `pi` that cannot be reached at
                       all -- the mutation test for #160's fail-closed
                       requirement.
PI_RPC_LOG=<path>    -- every `prompt` message received is appended here,
                       one per line, so a test can assert the real brief
                       pointer text crossed the RPC wire (never send-keys).
PI_RPC_SESSION_ID    -- session id to answer with when the caller did not
                       already resume one via --session/--session-id
                       (default: sess-stub-1).
"""
import json
import os
import sys

SESSION_ID = os.environ.get("PI_RPC_SESSION_ID", "sess-stub-1")
LOG_PATH = os.environ.get("PI_RPC_LOG")

if os.environ.get("PI_RPC_BROKEN"):
    sys.exit(1)

# --session/--session-id resume: answer back whichever id the caller asked
# to resume, mirroring the real CLI's behaviour (get_state on a resumed
# process reports the resumed session, not a fresh one).
session_id = SESSION_ID
args = sys.argv[1:]
for flag in ("--session", "--session-id"):
    if flag in args:
        session_id = args[args.index(flag) + 1]


def write(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    try:
        obj = json.loads(line)
    except json.JSONDecodeError:
        continue
    kind = obj.get("type")
    request_id = obj.get("id")
    if kind == "get_state":
        write({"id": request_id, "type": "response", "success": True,
               "data": {"sessionId": session_id, "sessionFile": f"/tmp/{session_id}.json"}})
    elif kind == "prompt":
        write({"id": request_id, "type": "response", "command": "prompt", "success": True})
        if LOG_PATH:
            with open(LOG_PATH, "a") as fh:
                fh.write((obj.get("message") or "") + "\n")
        write({
            "type": "message_end",
            "message": {
                "role": "assistant",
                "stopReason": "end_turn",
                "content": [{"type": "text", "text": "stub pi: brief received over RPC"}],
                "usage": {},
            },
        })
        write({"type": "agent_settled"})
