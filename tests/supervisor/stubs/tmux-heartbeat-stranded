#!/bin/bash
# Stub tmux for heartbeat.sh's #273 escalation test: the target pane EXISTS
# (capture-pane always exits 0, so has-session/capture checks pass and no
# window resolution is needed) but never shows the working-pane marker (its
# output never contains "esc to interrupt"), simulating a nudge that was
# sent but did not take -- the same "stranded pane" shape quota-watch.sh's
# stub covers for the resume/wind-down case. Also answers `list-windows -a`
# empty so nothing reads as pane-working, forcing the STALLED branch.
LOG="${TMUX_LOG:?}"
printf '%s\n' "$*" >> "$LOG"
case "$1" in
  has-session) exit 0 ;;
  list-windows) exit 0 ;;
  capture-pane) echo "\$" ;;
esac
exit 0
