#!/bin/bash
# Stub gh for claim.sh and dispatch.sh tests.
#
# GH_ISSUES holds one line per open issue:   <number>|<assignees-csv>|<title>|<state>
# GH_PRS    holds one line per open PR:      <number>|<body>|<headRefName>|<commit-msgs>
#
# <state> is optional and defaults to OPEN when the field is absent, so
# fixtures written before #95 (three fields) still describe open issues.
#
# <headRefName> is optional and defaults to empty (agent-dotfiles#212 added
# it) so fixtures written before that landed (two fields) still describe PR
# bodies for `claim.sh stale`, which never reads this column.
#
# <commit-msgs> is optional and defaults to empty (agent-supervisor#35 added
# it): a `;`-separated list of commit message headlines, used to synthesize
# `pr view --json commits` for the authorship guard's commit-message
# fallback. `pr view --json closingIssuesReferences` is synthesized from
# <body> the same way real GitHub derives it: a `Fixes|Closes|Resolves #N`
# match, case-insensitive.
#
# Writes land back in GH_ISSUES, so a claim taken by one invocation is visible
# to the next -- which is the whole point of the test: a SECOND dispatcher must
# see what the first one wrote. A stub that discarded writes would pass the
# refusal test for the wrong reason.
set -uo pipefail
I="${GH_ISSUES:?}"
P="${GH_PRS:-/dev/null}"
ME="${GH_ME:-jonhill90}"

sub="$1"; shift
case "$sub" in
  api)
    # agent-supervisor#144: claim.sh now speaks REST (`gh api repos/...`),
    # not GraphQL (`gh issue view`/`gh issue list`/`gh pr list`, still
    # stubbed below for dispatch.sh, which is unconverted). Requires the real
    # `jq` binary to emulate `gh api`'s own bundled `-q`/`--jq` -- present on
    # every CI runner this suite runs on.
    endpoint=""; method="GET"; jqf=""; fields=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --paginate) shift ;;
        -X) method="$2"; shift 2 ;;
        -q) jqf="$2"; shift 2 ;;
        -f) fields+=("$2"); shift 2 ;;
        *) endpoint="$1"; shift ;;
      esac
    done
    path="${endpoint%%\?*}"
    query=""
    case "$endpoint" in *\?*) query="${endpoint#*\?}" ;; esac
    emit() { # emit <json> -- apply -q if given, else print raw
      if [ -n "$jqf" ]; then jq -r "$jqf" <<<"$1"; else printf '%s\n' "$1"; fi
    }
    assignees_json_for() { # assignees_json_for <csv> -> [{"login":"a"},...]
      local csv="$1"
      [ -n "$csv" ] || { echo '[]'; return; }
      tr ',' '\n' <<<"$csv" | jq -R . | jq -sc 'map({login:.})'
    }
    case "$path" in
      user)
        emit "{\"login\":\"$ME\"}" ;;
      */issues/*/assignees)
        num=$(basename "$(dirname "$path")")
        who=""
        for f in ${fields[@]+"${fields[@]}"}; do case "$f" in assignees\[\]=*) who="${f#*=}" ;; esac; done
        tmp=$(mktemp)
        while IFS='|' read -r n a t st; do
          if [ "$n" = "$num" ] && [ -n "$who" ]; then
            if [ "$method" = "POST" ]; then
              case ",$a," in *",$who,"*) ;; *) a="${a:+$a,}$who" ;; esac
            elif [ "$method" = "DELETE" ]; then
              a=$(tr ',' '\n' <<<"$a" | grep -vx "$who" | paste -sd, -)
            fi
          fi
          printf '%s|%s|%s|%s\n' "$n" "$a" "$t" "$st"
        done < "$I" > "$tmp"
        mv "$tmp" "$I"
        emit '[]' ;;
      repos/*/issues/[0-9]*)
        num="${path##*/}"
        line=$(awk -F'|' -v n="$num" '$1==n' "$I")
        [ -n "$line" ] || { echo "gh: no issue $num" >&2; exit 1; }
        a=$(cut -d'|' -f2 <<<"$line"); st=$(cut -d'|' -f4 <<<"$line"); st="${st:-OPEN}"
        st=$(tr 'A-Z' 'a-z' <<<"$st")
        json=$(jq -nc --argjson number "$num" --arg state "$st" --argjson assignees "$(assignees_json_for "$a")" \
          '{number:$number, state:$state, assignees:$assignees}')
        emit "$json" ;;
      repos/*/issues)
        state_filter="open"
        case "$query" in *state=all*) state_filter="all" ;; esac
        out="[]"
        while IFS='|' read -r n a t st; do
          [ -n "$n" ] || continue
          st="${st:-OPEN}"; st=$(tr 'A-Z' 'a-z' <<<"$st")
          [ "$state_filter" = "open" ] && [ "$st" != "open" ] && continue
          entry=$(jq -nc --argjson number "$n" --arg state "$st" --argjson assignees "$(assignees_json_for "$a")" \
            '{number:$number, state:$state, assignees:$assignees}')
          out=$(jq -nc --argjson acc "$out" --argjson e "$entry" '$acc + [$e]')
        done < "$I"
        emit "$out" ;;
      repos/*/pulls)
        out="[]"
        while IFS='|' read -r n b h c; do
          [ -n "$n" ] || continue
          entry=$(jq -nc --argjson number "$n" --arg body "$b" '{number:$number, body:$body}')
          out=$(jq -nc --argjson acc "$out" --argjson e "$entry" '$acc + [$e]')
        done < "$P"
        emit "$out" ;;
      *) echo "gh-claim stub: unhandled api endpoint $path" >&2; exit 1 ;;
    esac
    exit 0 ;;
  issue)
    verb="$1"; shift
    num=""
    # First bare argument is the issue number for view/edit/comment.
    for a in "$@"; do case "$a" in [0-9]*) num="$a"; break ;; esac; done
    case "$verb" in
      view)
        line=$(awk -F'|' -v n="$num" '$1==n' "$I")
        [ -n "$line" ] || { echo "gh: no issue $num" >&2; exit 1; }
        a=$(cut -d'|' -f2 <<<"$line"); t=$(cut -d'|' -f3 <<<"$line")
        st=$(cut -d'|' -f4 <<<"$line"); st="${st:-OPEN}"
        # Only the -q shapes claim.sh asks for: state+assignees combined, or
        # assignees alone; anything else falls back to the title.
        if [[ "$*" == *"state"* && "$*" == *"assignees"* ]]; then
          printf '%s\t%s\n' "$st" "$a"
        elif [[ "$*" == *"assignees"* ]]; then
          printf '%s\n' "$a"
        else
          printf '%s\n' "$t"
        fi
        ;;
      list)
        # claim.sh asks for number<TAB>assignees over open issues.
        while IFS='|' read -r n a t; do printf '%s\t%s\n' "$n" "$a"; done < "$I"
        ;;
      edit)
        add=""; rm=""
        while [ $# -gt 0 ]; do
          case "$1" in
            --add-assignee) add="$2"; shift 2 ;;
            --remove-assignee) rm="$2"; shift 2 ;;
            *) shift ;;
          esac
        done
        [ "$add" = "@me" ] && add="$ME"
        [ "$rm" = "@me" ] && rm="$ME"
        tmp=$(mktemp)
        while IFS='|' read -r n a t st; do
          if [ "$n" = "$num" ]; then
            if [ -n "$add" ]; then
              case ",$a," in *",$add,"*) ;; *) a="${a:+$a,}$add" ;; esac
            fi
            if [ -n "$rm" ]; then
              a=$(tr ',' '\n' <<<"$a" | grep -vx "$rm" | paste -sd, -)
            fi
          fi
          printf '%s|%s|%s|%s\n' "$n" "$a" "$t" "$st"
        done < "$I" > "$tmp"
        mv "$tmp" "$I"
        ;;
    esac ;;
  pr)
    verb="$1"; shift
    case "$verb" in
      view)
        num=""
        for a in "$@"; do case "$a" in [0-9]*) num="$a"; break ;; esac; done
        line=$(awk -F'|' -v n="$num" '$1==n' "$P")
        [ -n "$line" ] || { echo "gh: no pull request $num" >&2; exit 1; }
        body=$(cut -d'|' -f2 <<<"$line")
        href=$(cut -d'|' -f3 <<<"$line")
        commit_msgs=$(cut -d'|' -f4 <<<"$line")
        issues_json="[]"
        issue_nums=$(grep -ioE '(fixes|closes|resolves) #[0-9]+' <<<"$body" | grep -oE '[0-9]+')
        if [ -n "$issue_nums" ]; then
          issues_json="[$(awk '{printf "%s{\"number\":%s}", (NR>1?",":""), $0}' <<<"$issue_nums")]"
        fi
        commits_json="[]"
        if [ -n "$commit_msgs" ]; then
          commits_json="[$(tr ';' '\n' <<<"$commit_msgs" | awk 'NF{printf "%s{\"messageHeadline\":\"%s\"}", (n++>0?",":""), $0}')]"
        fi
        printf '{"headRefName":"%s","closingIssuesReferences":%s,"commits":%s}\n' \
          "$href" "$issues_json" "$commits_json"
        ;;
      list)
        # pr list --json number,body -q '.[]|...'  -> number<TAB>body
        while IFS='|' read -r n b h; do [ -n "$n" ] && printf '%s\t%s\n' "$n" "$b"; done < "$P"
        ;;
    esac ;;
esac
exit 0
