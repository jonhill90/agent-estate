#!/bin/bash
# Stub pgrep for watchdog tests. Empty by default so test runs never observe
# unrelated inbox-poll.sh strings from the test harness's own process table.
if [ "$1" = "-f" ] && [ "${2:-}" = "inbox-poll.sh" ]; then
  if [ -n "${STUB_POLLER_PIDS:-}" ]; then
    printf '%s\n' $STUB_POLLER_PIDS
  fi
  exit 0
fi
exit 1
