#!/bin/bash
# Stub tmux for heartbeat.sh target-resolution tests (agent-supervisor#346).
#
# TMUX_SESSIONS     space-separated list of sessions that "exist"
# TMUX_GOOD_TARGET  the one session:window capture-pane succeeds on (the
#                   live Director pane, at whatever id it holds RIGHT NOW)
# TMUX_WINDOWS      space-separated window ids list-windows reports for the
#                   configured session -- simulates what is actually there
#                   after a restart, independent of what heartbeat.sh has
#                   hardcoded as its default target
LOG="${TMUX_LOG:?}"
printf '%s\n' "$*" >> "$LOG"

case "$1" in
  has-session)
    sess="$3"
    for s in $TMUX_SESSIONS; do [ "$s" = "$sess" ] && exit 0; done
    exit 1
    ;;
  list-windows)
    if [ "$2" = "-a" ]; then
      # whole-server scan the "pane-working" probe uses -- empty means
      # nothing reads as busy, which is what every case here wants.
      exit 0
    fi
    # $2=-t $3=SESSION $4=-F $5=format
    for w in $TMUX_WINDOWS; do printf '%s\n' "$w"; done
    ;;
  capture-pane)
    # $2=-p $3=-t $4="=session:target"
    tgt="${4#=}"
    if [ "$tgt" = "$TMUX_GOOD_TARGET" ]; then
      echo "esc to interrupt"
      exit 0
    fi
    exit 1
    ;;
  send-keys) : ;;
esac
exit 0
