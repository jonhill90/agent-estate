#!/bin/bash
# Stub tmux for quota-watch.sh target-resolution tests (agent-supervisor#346).
#
# Unlike tmux-heartbeat-target's session, `agent-supervisor` legitimately
# holds MANY windows (one per lane) -- "exactly one window" cannot be the
# resolution rule here the way it is for the single-purpose director
# session. This stub simulates that: several lane windows plus one named
# `supervisor` (bootstrap-session.sh's own convention), so a name-based
# resolve can be told apart from an "exactly one window" guess.
#
# TMUX_SESSIONS      space-separated sessions that "exist" (also list-sessions'
#                     answer, one per line -- agent-estate#789: resolve_target's
#                     guess path now scans every live session, not only the
#                     one parsed from the configured target)
# TMUX_GOOD_TARGET    the one session:window capture-pane succeeds on
# TMUX_WINDOWS_NAMED  newline-separated "id<TAB>name" pairs list-windows
#                     reports for EVERY session in TMUX_SESSIONS (this stub
#                     does not vary the answer per session -- tests that need
#                     per-session differences use per-session env vars named
#                     TMUX_WINDOWS_NAMED_<session>, checked first below)
LOG="${TMUX_LOG:?}"
printf '%s\n' "$*" >> "$LOG"

case "$1" in
  has-session)
    sess="$3"
    for s in $TMUX_SESSIONS; do [ "$s" = "$sess" ] && exit 0; done
    exit 1
    ;;
  list-sessions)
    # $2=-F $3=format
    for s in $TMUX_SESSIONS; do printf '%s\n' "$s"; done
    ;;
  list-windows)
    # $2=-t $3=SESSION $4=-F $5=format -- format is now
    # "#{session_name}\t#{window_id}\t#{window_name}" (agent-estate#789),
    # so this stub prepends the session it was asked about.
    sess="$3"
    var="TMUX_WINDOWS_NAMED_$(printf '%s' "$sess" | tr -c 'A-Za-z0-9_' '_')"
    named="${!var:-$TMUX_WINDOWS_NAMED}"
    printf '%b\n' "$named" | while IFS=$'\t' read -r wid wname; do
      [ -n "$wid" ] || continue
      printf '%s\t%s\t%s\n' "$sess" "$wid" "$wname"
    done
    ;;
  capture-pane)
    # $2=-p $3=-t $4="=session:target"
    tgt="${4#=}"
    if [ "$tgt" = "$TMUX_GOOD_TARGET" ]; then
      echo "esc to interrupt"
      exit 0
    fi
    exit 1
    ;;
  send-keys) : ;;
esac
exit 0
