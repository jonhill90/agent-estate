#!/bin/bash
# Test stub for weekly-watch.sh's `codexbar usage --provider claude --json`
# sampling loop (agent-supervisor#327). Emits one canned response per call,
# walking through WEEKLY_TEST_SEQUENCE (comma-separated) in order, mirroring
# the discipline of stubs/codexbar-sequence for quota.sh. WEEKLY_TEST_COUNTER
# names a scratch file this stub uses to remember which call it is on.
#
# Tokens, each "percent|resetsAt|pace" (pipe-separated -- resetsAt is an ISO
# timestamp and already contains colons) or a bare keyword:
#   NN|RESETS|PACE   -- usedPercent NN, resetsAt RESETS, pace summary PACE
#   empty            -- no output at all (codexbar fetch-failed / timeout)
#   bad              -- output that parses but has no usable usedPercent
set -uo pipefail

[ "${1:-}" = "usage" ] || { echo "codexbar-weekly-watch: only 'usage' is stubbed" >&2; exit 64; }

COUNTER="${WEEKLY_TEST_COUNTER:?WEEKLY_TEST_COUNTER must be set}"
SEQ="${WEEKLY_TEST_SEQUENCE:?WEEKLY_TEST_SEQUENCE must be set}"

n=0
[ -f "$COUNTER" ] && n=$(cat "$COUNTER")
n=$((n + 1))
printf '%s' "$n" > "$COUNTER"

IFS=',' read -r -a TOKENS <<< "$SEQ"
idx=$((n - 1))
tok="${TOKENS[$idx]:-${TOKENS[-1]}}"

case "$tok" in
  empty) exit 1 ;;
  bad)   printf '[{"usage":{"secondary":{}},"pace":{"secondary":{}}}]\n'; exit 0 ;;
  *)
    pct="${tok%%|*}"
    rest="${tok#*|}"
    resets="${rest%%|*}"
    pace="${rest#*|}"
    printf '[{"usage":{"secondary":{"usedPercent":%s,"resetsAt":"%s"}},"pace":{"secondary":{"summary":"%s"}}}]\n' \
      "$pct" "$resets" "$pace"
    exit 0
    ;;
esac
