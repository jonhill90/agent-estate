#!/bin/bash
# Stub tmux for lane-done.sh tests.
#
# LANES_FIXTURE holds one line per window, same format the other lane stubs
# use, only the name column matters here:
#   <index>|<name>
#
# WAIT_DIR holds the wait-for state: <channel>.signaled for a pending signal,
# <channel>.locked for a held lock.
#
# WHY this stub models the two wait-for forms as SEPARATE mechanisms: it
# previously implemented `-L` as "exit 0 if `-S` already wrote a marker",
# which is the behaviour of the *bare* form. That is the same misreading of
# `man tmux` the script under test had, so the whole suite passed against a
# fictional tmux while lane-done.sh renamed unfinished lanes in production
# (#108). Semantics below are what tmux 3.5 actually does, each line checked
# against a real throwaway server before being written here:
#
#   wait-for <ch>     blocks until someone runs `wait-for -S <ch>`. A signal
#                     sent before any waiter is latched and returns the next
#                     wait immediately; that signal is then consumed, so a
#                     second wait blocks again.
#   wait-for -S <ch>  releases one bare waiter, or latches if there is none.
#                     Does NOT release a client blocked in `-L`.
#   wait-for -L <ch>  locks the channel: returns IMMEDIATELY when the channel
#                     is unlocked, blocks only against another locker, and is
#                     released by `-U`, never by `-S`.
#   wait-for -U <ch>  unlocks.
#
# The one deliberate infidelity: a real block is unbounded, which would hang
# the test process, so blocking here is a bounded poll (STUB_WAIT_TIMEOUT
# seconds, default 5) that exits 1 on expiry. Tests must therefore assert on
# "did it block", not on "did it block forever". Because the stub can only
# approximate blocking, tests/supervisor/test_lane_done.sh also carries one
# assertion against real tmux -- a stub is a claim about an external tool,
# and an unchecked claim is not evidence.
F="${LANES_FIXTURE:?}"
LOG="${TMUX_LOG:-/dev/null}"
WD="${WAIT_DIR:?}"
TIMEOUT="${STUB_WAIT_TIMEOUT:-5}"
sub="$1"; shift

# Poll for $1 to exist, up to $TIMEOUT seconds. 0 -> appeared, 1 -> expired.
block_until() {
  local target="$1" waited=0
  local limit=$(( TIMEOUT * 20 ))
  while [ ! -e "$target" ]; do
    [ "$waited" -ge "$limit" ] && return 1
    sleep 0.05
    waited=$(( waited + 1 ))
  done
  return 0
}

case "$sub" in
  wait-for)
    mode=""; ch=""
    case "${1:-}" in
      -*) mode="$1"; ch="${2:-}" ;;
      *)  ch="${1:-}" ;;
    esac
    [ -n "$ch" ] || exit 1
    mkdir -p "$WD"
    case "$mode" in
      # Bare rendezvous: block until signaled, then consume the signal.
      "")
        block_until "$WD/$ch.signaled" || exit 1
        rm -f "$WD/$ch.signaled"
        exit 0 ;;
      # Signal: release a bare waiter, or latch for the next one. Never
      # touches lock state -- `-S` does not release an `-L` client.
      -S) : > "$WD/$ch.signaled"; exit 0 ;;
      # Lock: succeeds at once on an unlocked channel, whatever `-S` has or
      # has not done. Blocks only while another locker holds it.
      -L)
        if [ -e "$WD/$ch.locked" ]; then
          block_until_unlocked=0
          while [ -e "$WD/$ch.locked" ]; do
            [ "$block_until_unlocked" -ge $(( TIMEOUT * 20 )) ] && exit 1
            sleep 0.05
            block_until_unlocked=$(( block_until_unlocked + 1 ))
          done
        fi
        : > "$WD/$ch.locked"
        exit 0 ;;
      -U) rm -f "$WD/$ch.locked"; exit 0 ;;
      *) exit 1 ;;
    esac ;;
  rename-window)
    printf '%s %s\n' "$sub" "$*" >> "$LOG"
    exit 0 ;;
esac

target=""; fmt=""
while [ $# -gt 0 ]; do
  case "$1" in
    -t) target="$2"; shift 2 ;;
    -p) shift ;;
    -*) shift ;;
    *) fmt="$1"; shift ;;
  esac
done
win="${target##*:}"; win="${win%%.*}"
line=$(awk -F'|' -v w="$win" '$1==w' "$F")
case "$sub" in
  display-message)
    case "$fmt" in
      '#{window_name}') cut -d'|' -f2 <<<"$line" ;;
    esac ;;
esac
exit 0
