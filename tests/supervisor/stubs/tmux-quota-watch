#!/bin/bash
# Stub tmux for quota-watch.sh tests. Records every invocation verbatim to
# TMUX_LOG so a test can assert on exactly what was sent -- including the
# case that matters most, that nothing was sent at all -- and answers
# `capture-pane` with a working-pane shape so send_message's delivery check
# (grep for "esc to interrupt") always passes.
LOG="${TMUX_LOG:?}"
printf '%s\n' "$*" >> "$LOG"
case "$1" in
  capture-pane) echo "esc to interrupt" ;;
esac
exit 0
