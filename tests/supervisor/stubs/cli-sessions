#!/bin/bash
# Stub `cli.py status` for sessions.sh tests. sessions.sh calls
# `<python> <cli> --state-dir <dir> status` and reads only the `lanes[].lane`
# identities out of the result -- see SESSIONS_KNOWN in sessions.sh -- so
# this prints just enough of the real shape to exercise that: lane ids of
# the form `<session>:<index>`, which is what `cli.py register` actually
# produces.
#
# CLI_SESSIONS_KNOWN, space separated, names which sessions this run of the
# fixture claims to have a registered lane in.
cat <<JSON
{"lanes": [$(
  first=1
  for s in ${CLI_SESSIONS_KNOWN:-}; do
    [ "$first" -eq 1 ] && first=0 || printf ','
    printf '{"lane": "%s:1"}' "$s"
  done
)], "tasks": []}
JSON
