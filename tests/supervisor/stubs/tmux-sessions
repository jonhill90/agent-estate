#!/bin/bash
# Stub tmux for sessions.sh tests. Unlike stubs/tmux-lanes (one session,
# already exercised by test_lanes.sh), this stub models SEVERAL sessions at
# once, because sessions.sh's whole job is aggregating across them.
#
# LANES_FIXTURE holds one line per window, across every session:
#   <session>|<index>|<name>|<command>|<pane-text>|<activity-age-seconds>|<in-mode>
#
# Per-lane STATE classification (busy/hung/dead/...) is exhaustively covered
# by test_lanes.sh against the single-session stub; this fixture only needs
# enough shapes to prove sessions.sh aggregates correctly -- one lane row per
# session is enough unless a check specifically needs more.
F="${LANES_FIXTURE:?}"
PID_BASE="${LANES_STUB_PID_BASE:-9000}"
WID_BASE="${LANES_STUB_WID_BASE:-100}"

# A window is identified by (session, index); this stub's pid/id namespace
# is the row's 1-based line number in the fixture, so two sessions can each
# have their own "window 2" without colliding.
row_for() { # row_for <session> <index>
  awk -F'|' -v s="$1" -v w="$2" 'BEGIN{n=0} {n++; if ($1==s && $2==w) {print n; exit}}' "$F"
}
# The scripts under test address panes by window ID (`@N`), same as the real
# session does (#241) -- resolve that back to the plain index this stub's
# fixture keys on, mirroring stubs/tmux-lanes' idx_for.
idx_for_row() { # idx_for_row <row-number> -> that row's index field
  awk -F'|' -v n="$1" 'NR==n{print $2}' "$F"
}

sub="$1"; shift
target=""; fmt=""
while [ $# -gt 0 ]; do
  case "$1" in
    -t) target="$2"; shift 2 ;;
    -p|-S) shift ;;
    -*) shift ;;
    *) fmt="$1"; shift ;;
  esac
done
session="${target%%:*}"
winpart="${target#*:}"
win="${winpart%%.*}"
case "$win" in
  @*) win="$(idx_for_row "$(( ${win#@} - WID_BASE ))")" ;;
esac

case "$sub" in
  list-sessions)
    awk -F'|' '{print $1}' "$F" | awk '!seen[$0]++' ;;
  has-session)
    awk -F'|' -v s="$session" 'BEGIN{f=0} $1==s{f=1} END{exit !f}' "$F" ;;
  list-panes)
    now=$(date +%s)
    awk -F'|' -v s="$session" '$1==s' "$F" | \
    while IFS='|' read -r se i n c t a m; do
      row=$(row_for "$se" "$i")
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$i" "$n" "$c" "$((now - a))" "${m:-0}" "$((PID_BASE + row))" "@$((WID_BASE + row))" "$(dirname "$F")"
    done ;;
  display-message)
    line=$(awk -F'|' -v s="$session" -v w="$win" '$1==s && $2==w' "$F")
    case "$fmt" in
      '#{window_activity}') echo $(( $(date +%s) - $(cut -d'|' -f6 <<<"$line") )) ;;
      '#{window_name}')            cut -d'|' -f3 <<<"$line" ;;
      '#{pane_current_command}')   cut -d'|' -f4 <<<"$line" ;;
      '#{window_index}')           printf '%s\n' "$win" ;;
      '#{pane_current_path}')      dirname "$F" ;;
    esac ;;
  capture-pane)
    line=$(awk -F'|' -v s="$session" -v w="$win" '$1==s && $2==w' "$F")
    printf '%s\n' "$(cut -d'|' -f5 <<<"$line")" ;;
esac
exit 0
