#!/bin/bash
# Stub tmux for quota-watch.sh's #273 escalation test: simulates a pane that
# EXISTS (capture-pane exits 0, so resolve_target succeeds and send_message
# proceeds to send-keys) but never shows the working-pane marker afterwards
# (capture-pane's OUTPUT never contains "esc to interrupt", so send_message's
# own delivery check fails) -- the exact "sent but did NOT take" shape #273
# is about. Records every invocation verbatim to TMUX_LOG.
LOG="${TMUX_LOG:?}"
printf '%s\n' "$*" >> "$LOG"
case "$1" in
  capture-pane) echo "\$" ;;
esac
exit 0
