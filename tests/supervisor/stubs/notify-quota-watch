#!/bin/bash
# Stub notify.sh for quota-watch.sh's #305 blind-alarm tests. Records every
# invocation (subject + body, one line each) to NOTIFY_LOG so a test can
# assert exactly how many pages went out and what they said -- including
# the case that matters most, that nothing paged at all. Exits 0 (channel
# accepted) unless NOTIFY_FAIL is set, so a test can also cover "the page
# itself failed to send".
LOG="${NOTIFY_LOG:?}"
printf 'CALLER=%s SUBJECT=%s BODY=%s\n' "${AGENT_NOTIFY_CALLER:-}" "${1:-}" "${2:-}" >> "$LOG"
[ -n "${NOTIFY_FAIL:-}" ] && exit 1
exit 0
