#!/bin/bash
# Stub tmux for lanes.sh tests. LANES_FIXTURE holds one line per window:
#   <index>|<name>|<command>|<pane-text>|<activity-age-seconds>|<in-mode>|<box>|<pane-argv>
# The 5th column is how many seconds ago tmux last saw output, which is what
# separates hung from busy. It replaced a two-capture scheme that diffed pane
# text: Claude Code's elapsed footer is minute-granular past 60s, so a live
# turn emits identical bytes for a whole minute and was reported hung.
#
# The 7th column models the INPUT BOX (#141), rendered in the shape a real
# Claude Code pane paints -- `❯` + U+00A0, wrapped in a pair of horizontal
# rules -- because that shape, not the plain text, is what input-box.sh keys
# on. Values:
#
#   (absent)   no box is rendered; input_box_state answers `unknown` and
#              classification is exactly what it was before #141. Every
#              pre-existing fixture is in this case, on purpose.
#   -          an empty box
#   dim:TEXT   an empty box showing Claude Code's DIM placeholder suggestion.
#              This is the fixture that matters most: in a plain capture it is
#              indistinguishable from an unsent brief, and a first version of
#              input-box.sh called it `text` and would have withheld every
#              idle lane in the estate.
#   TEXT       a box holding TEXT that was typed and never submitted
#
# `capture-pane -e` is what carries the dim attribute, so the box is emitted
# with real SGR: dim is ESC[2m ... ESC[0m, exactly as the live TUI paints it.
#
# The 8th column models the argv of the pane's FIRST process (#154) -- what
# `ps -o args= -p #{pane_pid}` prints. `pane_pid` is emitted here as
# PID_BASE + window index, and stubs/ps-lanes maps it back to this column, so
# a fixture row can say "this pane's own process is the Telegram poller"
# rather than starting one. Omitted, it defaults to `-zsh`, which is what
# every real lane in the live session measured as on 2026-08-11 -- the agent
# runs as a CHILD of the pane's login shell. Every pre-existing fixture row is
# in that case, on purpose.
F="${LANES_FIXTURE:?}"
# Kept in sync with stubs/ps-lanes.
PID_BASE="${LANES_STUB_PID_BASE:-9000}"

# agent-dotfiles#241: windows now have TWO names -- the index (a slot number,
# what the fixture keys on) and tmux's own `#{window_id}` (`@N`, stable for
# the window's lifetime). The scripts under test address panes by id, so this
# stub has to answer to both. Ids are synthesised as WID_BASE + index and are
# deliberately NOT equal to the index: a stub where `@5` and `5` were the same
# string could not tell an id-addressed call from an index-addressed one, and
# the whole point of #241's tests is that distinction.
WID_BASE="${LANES_STUB_WID_BASE:-100}"
wid_for()  { printf '@%s' "$(( WID_BASE + $1 ))"; }
# Resolve whatever came after `session:` back to a fixture index. An `@N`
# target is a window id; anything else is already an index.
idx_for() {
  local w="$1"
  case "$w" in
    @*) printf '%s' "$(( ${w#@} - WID_BASE ))" ;;
    *)  printf '%s' "$w" ;;
  esac
}
sub="$1"; shift
target=""; fmt=""
while [ $# -gt 0 ]; do
  case "$1" in
    -t) target="$2"; shift 2 ;;
    -p|-S) shift ;;
    -*) shift ;;
    *) fmt="$1"; shift ;;
  esac
done
win="${target##*:}"; win="${win%%.*}"
win="$(idx_for "$win")"
line=$(awk -F'|' -v w="$win" '$1==w' "$F")
case "$sub" in
  has-session) exit 0 ;;
  list-windows) cut -d'|' -f1 "$F" ;;
  list-panes)
    # Mirrors the real -F used by lanes.sh: index, name, command, activity,
    # in-mode, pane pid, window id, tab separated, active pane only. The
    # window id is synthesised (#241) rather than being a fixture column --
    # no fixture needs to CHOOSE an id, only to have one that differs from
    # the index.
    now=$(date +%s)
    # `b` absorbs the input-box column so it cannot leak into `m`: with a
    # 6-variable read, a 7-field row put "0|<box>" into the in-mode slot and
    # every boxed fixture reported `scrolled`. `p` does the same for the argv
    # column added in #154.
    while IFS='|' read -r i n c t a m b p; do
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$i" "$n" "$c" "$((now-a))" "${m:-0}" "$((PID_BASE+i))" "$(wid_for "$i")"
    done < "$F" ;;
  display-message)
    case "$fmt" in
      '#{window_name}') cut -d'|' -f2 <<<"$line" ;;
      '#{pane_current_command}') cut -d'|' -f3 <<<"$line" ;;
      '#{window_activity}') echo $(( $(date +%s) - $(cut -d'|' -f5 <<<"$line") )) ;;
      '#{window_index}') printf '%s\n' "$win" ;;
      '#{window_id}') wid_for "$win"; printf '\n' ;;
    esac ;;
  capture-pane)
    # The input box sits ABOVE the status line in a real pane, so it is
    # emitted first and the fixture's pane column stays last -- lanes.sh reads
    # the last non-empty line, and that must keep meaning the status line.
    box=$(cut -d'|' -f7 <<<"$line")
    if [ -n "$box" ]; then
      rule=$(printf '─%.0s' $(seq 1 40))
      printf '%s\n' "$rule"
      case "$box" in
        -)      printf '\033[39m❯\xc2\xa0\n' ;;
        dim:*)  printf '\033[39m❯\xc2\xa0\033[2m%s\033[0m\n' "${box#dim:}" ;;
        *)      printf '\033[39m❯\xc2\xa0%s\n' "$box" ;;
      esac
      printf '%s\n' "$rule"
    fi
    # \n in the fixture's pane column becomes a real newline, so a test can
    # express "the phrase is in the scrollback but not on the status line" --
    # the live case that made idle lanes report busy.
    printf '%b\n' "$(cut -d'|' -f4 <<<"$line")" ;;
esac
exit 0
