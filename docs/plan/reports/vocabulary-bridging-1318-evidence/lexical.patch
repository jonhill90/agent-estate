+package knowledge
+
+import (
+	"os"
+	"reflect"
+	"runtime"
+	"sort"
+	"testing"
+	"time"
+
+	"github.com/jonhill90/agent-estate/estate/internal/knowledge/goldenset"
+)
+
+var lexicalExperimentScorerSink *BM25Scorer
+var lexicalExperimentTokenSink int
+
+// BenchmarkLexicalScorerConstruction is scratch-only instrumentation for
+// comparing the shipped and projected token-stat construction on one frozen
+// compiled index. It emits no item text and must not ship.
+func BenchmarkLexicalScorerConstruction(b *testing.B) {
+	path := os.Getenv("ESTATE_LEXICAL_INDEX")
+	if path == "" {
+		b.Skip("ESTATE_LEXICAL_INDEX is unset")
+	}
+	res, err := Read(path)
+	if err != nil {
+		b.Fatal(err)
+	}
+	original := lexicalExperimentLegacy
+	defer func() { lexicalExperimentLegacy = original }()
+	for _, tc := range []struct {
+		name   string
+		legacy bool
+	}{{"shipped", true}, {"projected", false}} {
+		b.Run(tc.name, func(b *testing.B) {
+			lexicalExperimentLegacy = tc.legacy
+			b.ReportAllocs()
+			b.ReportMetric(float64(len(res.Items)), "items")
+			b.ResetTimer()
+			for i := 0; i < b.N; i++ {
+				lexicalExperimentScorerSink = NewBM25Scorer(res.Items)
+			}
+		})
+	}
+}
+
+// BenchmarkLexicalProjectionOnly isolates token construction from BM25 maps,
+// IDF, scoring, index reads, and semantic work. One operation tokenizes every
+// scored field in the frozen index once.
+func BenchmarkLexicalProjectionOnly(b *testing.B) {
+	path := os.Getenv("ESTATE_LEXICAL_INDEX")
+	if path == "" {
+		b.Skip("ESTATE_LEXICAL_INDEX is unset")
+	}
+	res, err := Read(path)
+	if err != nil {
+		b.Fatal(err)
+	}
+	type tokenizer func(string) []string
+	for _, tc := range []struct {
+		name string
+		fn   tokenizer
+	}{{"shipped", splitWordsLegacy}, {"projected", splitWordsProjected}} {
+		b.Run(tc.name, func(b *testing.B) {
+			b.ReportAllocs()
+			b.ReportMetric(float64(len(res.Items)), "items")
+			for i := 0; i < b.N; i++ {
+				n := 0
+				for _, it := range res.Items {
+					for _, field := range lexicalFields(it) {
+						n += len(tc.fn(field))
+					}
+				}
+				lexicalExperimentTokenSink = n
+			}
+		})
+	}
+}
+
+func TestLexicalProjectionShape(t *testing.T) {
+	got := splitWords("loggedIn JSONParser unrequested")
+	want := []string{"loggedin", "logged", "in", "jsonparser", "json", "parser", "unrequested"}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("splitWords projection = %v, want %v", got, want)
+	}
+	requested := queryTerms("requested")
+	negated := fieldTermCounts("unrequested")
+	if len(requested) != 1 || negated[requested[0]] != 0 {
+		t.Fatalf("negation collapsed: query terms=%v negated-count=%d", requested, negated[requested[0]])
+	}
+}
+
+func TestLexicalExperimentAffectedQueries(t *testing.T) {
+	type stratum struct {
+		name string
+		load func() ([]goldenset.Case, error)
+	}
+	strata := []stratum{
+		{"retrieval", goldenset.LoadRetrievalBaseline},
+		{"cases", goldenset.Load},
+		{"natural", goldenset.LoadNatural},
+		{"stars", goldenset.LoadStars},
+	}
+	original := lexicalExperimentLegacy
+	defer func() { lexicalExperimentLegacy = original }()
+	for _, s := range strata {
+		cases, err := s.load()
+		if err != nil {
+			t.Fatal(err)
+		}
+		var affected []string
+		for _, c := range cases {
+			lexicalExperimentLegacy = true
+			shipped := queryTerms(c.Question)
+			lexicalExperimentLegacy = false
+			projected := queryTerms(c.Question)
+			if !reflect.DeepEqual(shipped, projected) {
+				affected = append(affected, c.ID)
+			}
+		}
+		t.Logf("stratum=%s affected_queries=%d total=%d ids=%v", s.name, len(affected), len(cases), affected)
+	}
+}
+
+func legacyFieldTermCounts(text string) map[string]int {
+	counts := map[string]int{}
+	for _, f := range splitWordsLegacy(text) {
+		if len(f) <= 2 || stopWords[f] {
+			continue
+		}
+		counts[stem(f)]++
+	}
+	return counts
+}
+
+func lexicalMedian(ds []time.Duration) time.Duration {
+	sort.Slice(ds, func(i, j int) bool { return ds[i] < ds[j] })
+	return ds[len(ds)/2]
+}
+
+// TestLexicalExperimentAlternatingConstruction alternates which variant runs
+// first on every pair so warm caches and transient system load do not always
+// benefit the same arm. Counts and durations only; no indexed text is emitted.
+func TestLexicalExperimentAlternatingConstruction(t *testing.T) {
+	path := os.Getenv("ESTATE_LEXICAL_INDEX")
+	if path == "" {
+		t.Skip("ESTATE_LEXICAL_INDEX is unset")
+	}
+	res, err := Read(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	original := lexicalExperimentLegacy
+	defer func() { lexicalExperimentLegacy = original }()
+	measure := func(legacy bool) time.Duration {
+		lexicalExperimentLegacy = legacy
+		started := time.Now()
+		lexicalExperimentScorerSink = NewBM25Scorer(res.Items)
+		return time.Since(started)
+	}
+	var shipped, projected []time.Duration
+	for i := 0; i < 12; i++ {
+		runtime.GC()
+		if i%2 == 0 {
+			shipped = append(shipped, measure(true))
+			projected = append(projected, measure(false))
+		} else {
+			projected = append(projected, measure(false))
+			shipped = append(shipped, measure(true))
+		}
+	}
+	shippedMedian := lexicalMedian(shipped)
+	projectedMedian := lexicalMedian(projected)
+	t.Logf("items=%d pairs=%d shipped_median_ns=%d projected_median_ns=%d delta_ns=%d delta_percent=%.2f",
+		len(res.Items), len(shipped), shippedMedian.Nanoseconds(), projectedMedian.Nanoseconds(),
+		(projectedMedian - shippedMedian).Nanoseconds(), 100*float64(projectedMedian-shippedMedian)/float64(shippedMedian))
+}
+
+func lexicalFields(it Item) []string {
+	return []string{tier1SearchableText(it), ancestorSearchableText(it), tier2SearchableText(it)}
+}
+
+// TestLexicalExperimentAffectedDocuments reports counts only: no item text,
+// titles, permalinks, or private source material leave the test.
+func TestLexicalExperimentAffectedDocuments(t *testing.T) {
+	path := os.Getenv("ESTATE_LEXICAL_INDEX")
+	if path == "" {
+		t.Skip("ESTATE_LEXICAL_INDEX is unset")
+	}
+	res, err := Read(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	bySource := map[string]int{}
+	total := 0
+	for _, it := range res.Items {
+		affected := false
+		for _, field := range lexicalFields(it) {
+			if !reflect.DeepEqual(legacyFieldTermCounts(field), fieldTermCounts(field)) {
+				affected = true
+				break
+			}
+		}
+		if affected {
+			total++
+			bySource[it.Source]++
+		}
+	}
+	sources := make([]string, 0, len(bySource))
+	for source := range bySource {
+		sources = append(sources, source)
+	}
+	sort.Strings(sources)
+	t.Logf("affected_total=%d index_total=%d", total, len(res.Items))
+	for _, source := range sources {
+		t.Logf("affected_source=%s count=%d", source, bySource[source])
+	}
+}
+
+func TestLexicalExperimentVault02Token(t *testing.T) {
+	path := os.Getenv("ESTATE_LEXICAL_INDEX")
+	target := os.Getenv("ESTATE_LEXICAL_VAULT02_TARGET")
+	if path == "" || target == "" {
+		t.Skip("lexical experiment env is unset")
+	}
+	res, err := Read(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, it := range res.Items {
+		if it.ID != target {
+			continue
+		}
+		legacy, projected := 0, 0
+		for _, field := range lexicalFields(it) {
+			legacy += legacyFieldTermCounts(field)["log"]
+			projected += fieldTermCounts(field)["log"]
+		}
+		t.Logf("target_found=true legacy_log_count=%d projected_log_count=%d", legacy, projected)
+		if legacy != 0 || projected == 0 {
+			t.Fatalf("unexpected token bridge: legacy=%d projected=%d", legacy, projected)
+		}
+		return
+	}
+	t.Fatal("target_found=false")
+}
