+func splitWordsProjected(s string) []string {
+	raw := strings.FieldsFunc(s, func(r rune) bool {
+		return !('a' <= r && r <= 'z' || 'A' <= r && r <= 'Z' || '0' <= r && r <= '9')
+	})
+	words := make([]string, 0, len(raw))
+	for _, token := range raw {
+		// Preserve the original token in the same lowercased space the
+		// shipped scorer uses. The projection only adds components.
+		words = append(words, strings.ToLower(token))
+		parts := splitCamelToken(token)
+		if len(parts) <= 1 {
+			continue
+		}
+		for _, part := range parts {
+			words = append(words, strings.ToLower(part))
+		}
+	}
+	return words
+}
+
+func splitWordsLegacy(s string) []string {
 	return strings.FieldsFunc(strings.ToLower(s), func(r rune) bool {
 		return !('a' <= r && r <= 'z' || '0' <= r && r <= '9')
 	})
 }
 
+// splitCamelToken splits lower-to-upper transitions and the final capital of
+// an acronym before a title-cased word. It does not remove prefixes or suffixes;
+// a plain token such as "unrequested" remains one token, preserving negation.
+func splitCamelToken(token string) []string {
+	start := 0
+	var parts []string
+	for i := 1; i < len(token); i++ {
+		curUpper := 'A' <= token[i] && token[i] <= 'Z'
+		if !curUpper {
+			continue
+		}
+		prevLowerOrDigit := 'a' <= token[i-1] && token[i-1] <= 'z' || '0' <= token[i-1] && token[i-1] <= '9'
+		nextLower := i+1 < len(token) && 'a' <= token[i+1] && token[i+1] <= 'z'
+		prevUpper := 'A' <= token[i-1] && token[i-1] <= 'Z'
+		if prevLowerOrDigit || prevUpper && nextLower {
+			parts = append(parts, token[start:i])
+			start = i
+		}
+	}
+	if len(parts) == 0 {
+		return []string{token}
+	}
+	return append(parts, token[start:])
+}
