<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jonhill.weekly-watch</string>
  <!-- agent-supervisor#327. Pages Jon on Telegram before the WEEKLY cap runs
       out, because the recovery (switch to the second account) is his and
       needs lead time. It never stops anything: quota_weekly=spend_it_all.

       1800s is deliberate. The weekly moves slowly -- roughly 1 point an hour
       at this estate's burn -- so a 30-minute poll cannot miss a threshold,
       and polling faster would only add noise. Contrast the 900s schedulers,
       which watch the fast-moving session window. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/jon/source/repos/Personal/agent-supervisor/scripts/supervisor/weekly-watch.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/jon/.local/bin</string>
    <key>HOME</key>
    <string>/Users/jon</string>
    <!-- codexbar needs USER: measured 2026-08-18, 5/5 exitCode 0 with it set,
         3/3 exitCode 69 (fetch-failed) without. launchd sets neither USER nor
         LOGNAME, which is why every scheduler read the quota meter as broken
         for a full day while the identical call from a shell worked. -->
    <key>USER</key>
    <string>jon</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/jon/.local/state/agent-dotfiles-supervisor/weekly-watch.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jon/.local/state/agent-dotfiles-supervisor/weekly-watch.log</string>
</dict>
</plist>
